---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import FormStatus from '../components/FormStatus.astro';
import { site } from '../data/site';

const besoins = [
  'Architecture ou déploiement DHIS2',
  'Interopérabilité des systèmes',
  'Surveillance et alerte précoce',
  'IA et analyse de données',
  "Évaluation d'une application",
  'Formation',
  "Partenariat pour un appel d'offres",
  'Autre',
];
---

<Base
  title="Contact"
  description="Contactez Sowkad pour un projet de santé numérique : DHIS2, interopérabilité, surveillance, IA, évaluation ou partenariat pour un appel d'offres.">
  <section class="container contact">
    <div class="contact__info stack" style="--gap: 24px">
      <p class="eyebrow">Contact</p>
      <h1 class="display" style="font-size: clamp(38px, 4.6vw, 60px)">Parlons de votre projet.</h1>
      <p class="lead">
        Ministère, bailleur, ONG ou bureau d'études à la recherche d'un partenaire technique pour un appel d'offres :
        décrivez votre besoin, nous revenons vers vous avec une première approche.
      </p>
      <ul class="coords">
        <li>
          <Icon name="mail" size={22} />
          <div><span class="small muted">E-mail</span><a href={`mailto:${site.email}`}>{site.email}</a></div>
        </li>
        <li>
          <Icon name="phone" size={22} />
          <div><span class="small muted">Téléphone / WhatsApp</span><span>{site.phone}</span></div>
        </li>
        <li>
          <Icon name="pin" size={22} />
          <div><span class="small muted">Adresse</span><span>{site.address}</span></div>
        </li>
      </ul>
    </div>

    <form class="form contact__form" action="/envoi.php" method="post">
      <FormStatus />
      <input type="hidden" name="type" value="contact" />
      <div class="form__row">
        <label class="field">Nom complet<input type="text" name="nom" required autocomplete="name" /></label>
        <label class="field">Organisation<input type="text" name="organisation" autocomplete="organization" /></label>
        <label class="field">E-mail<input type="email" name="email" required autocomplete="email" /></label>
        <label class="field">Pays concerné<input type="text" name="pays" /></label>
      </div>
      <label class="field"
        >Type de besoin
        <select name="besoin">{besoins.map((b) => <option>{b}</option>)}</select>
      </label>
      <label class="field">Votre message<textarea name="message" rows="6" required></textarea></label>
      <label class="consent"
        ><input type="checkbox" name="consentement" required /><span>J'accepte que mes données soient utilisées pour répondre
        à ma demande, conformément aux <a href="/mentions-legales/">mentions légales</a>.</span></label
      >
      <label class="hp" aria-hidden="true">Ne pas remplir<input type="text" name="site_web" tabindex="-1" autocomplete="off" /></label>
      <button type="submit" class="btn btn--primary" style="align-self: flex-start">Envoyer</button>
    </form>
  </section>
</Base>

<style>
  .contact {
    display: flex;
    flex-wrap: wrap;
    gap: 48px 72px;
    padding-block: 72px 96px;
  }
  .contact__info {
    flex: 1 1 360px;
    min-width: 0;
  }
  .contact__form {
    flex: 1.4 1 480px;
    min-width: 0;
  }
  .coords {
    list-style: none;
    margin: 0;
    padding: 12px 0 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .coords li {
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }
  .coords li :global(svg) {
    flex: none;
    margin-top: 2px;
  }
  .coords div {
    display: flex;
    flex-direction: column;
    font-size: 17px;
    font-weight: 600;
  }
  .coords .small {
    font-weight: 400;
  }
  @media (max-width: 640px) {
    .contact {
      padding-block: 40px 64px;
    }
  }
</style>
