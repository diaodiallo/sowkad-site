---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import portraitPied from '../assets/photos/portrait-pied.jpg';

const parcours = [
  { when: '2026', role: 'Consultant — FHI 360, projet STRIDES', where: 'Maroc · surveillance épidémiologique numérique' },
  { when: '2026', role: 'Ingénieur interopérabilité senior — Madiro', where: 'Burundi, Madagascar · OpenFn, DHIS2' },
  { when: '2026', role: 'Chercheur associé en IA pour la santé publique — ANSS', where: 'Guinée · prédiction des alertes épidémiques' },
  { when: "2025 — aujourd'hui", role: 'Consultant surveillance One Health — Projet PReSeS-AOC', where: 'Guinée · financement Banque mondiale · EBS/CEBS dans DHIS2' },
  { when: '2021 — 2025', role: 'Spécialiste des systèmes de santé numériques — JSI', where: 'À distance · paludisme, TB, planification familiale' },
  { when: '2018 — 2021', role: 'Consultant en santé mondiale', where: 'Guinée, Burundi, Niger · JSI, GIZ, ICF, CRS, Digital Square' },
  { when: '2016 — 2018', role: "Ingénieur systèmes d'information sanitaire — JSI", where: 'Guinée · déploiement national de DHIS2' },
  { when: '2014 — 2016', role: 'Spécialiste IT et systèmes — Advalis', where: 'Conakry · collecte de données ODK, SIG, infrastructure' },
];

const formation = [
  { title: 'Master en Intelligence artificielle pour la santé publique', where: 'Aix-Marseille Université · 2025–2026' },
  { title: "Master 1 Ingénierie des systèmes d'information en santé", where: 'Aix-Marseille Université · 2017–2018' },
  { title: 'Ingénierie informatique et réseaux', where: 'Université Nongo Conakry · 2011–2015' },
];

const certifications = [
  "DHIS2 Server Administration — Université d'Oslo",
  'FHIR Fundamentals — HL7 International',
  'FHIR Intermediate — HL7 International',
  'Machine Learning on AWS — Amazon Web Services',
  'Java et génie logiciel — Duke University',
  'Test Driven Development — IBM',
];

const outils = [
  'DHIS2', 'OpenFn', 'HL7 FHIR', 'OpenHIE', 'OpenMRS', 'OpenLMIS', 'ODK · Kobo · CommCare', 'Python · SQL',
  'LightGBM · SHAP', 'Power BI', 'QGIS', 'React · Flutter', 'Drupal', 'Docker · CI/CD', 'Linux',
];
---

<Base
  title="Le fondateur"
  description="Mamadou Diao Diallo, ingénieur en santé numérique et interopérabilité, fondateur de Sowkad : parcours, formation et certifications.">
  <section class="container hero-founder">
    <div class="photo hero-founder__photo">
      <Image
        src={portraitPied}
        alt={`${site.founder}, en pied`}
        widths={[480, 760, 1100]}
        sizes="(max-width: 900px) 100vw, 480px"
        loading="eager"
        style="object-position: 50% 40%"
      />
    </div>
    <div class="hero-founder__text stack" style="--gap: 24px">
      <p class="eyebrow">Le fondateur</p>
      <h1 class="display" style="font-size: clamp(40px, 5vw, 66px)">{site.founder}</h1>
      <p class="founder-role">Ingénieur en santé numérique et interopérabilité · Fondateur de Sowkad</p>
      <p class="lead">
        Depuis plus de dix ans, il conçoit et déploie des systèmes d'information sanitaire pour des ministères de la
        Santé en Afrique. Il a dirigé le premier déploiement national de DHIS2 en Guinée, connecté des dossiers
        patients, des laboratoires et des plateformes de surveillance dans plusieurs pays, et applique aujourd'hui
        l'apprentissage automatique à l'alerte épidémique précoce.
      </p>
      <p class="lead">
        Il a créé Sowkad pour mettre cette expérience au service des programmes de digitalisation des systèmes de
        santé, depuis la Guinée.
      </p>
      <div class="btn-row">
        <a href="/cv-mamadou-diao-diallo.pdf" class="btn btn--primary" download>
          <Icon name="download" size={18} color="currentColor" />
          Télécharger le CV (PDF)
        </a>
        <a href={site.linkedin} class="btn btn--outline" rel="noopener" target="_blank">LinkedIn</a>
        <a href={site.github} class="btn btn--outline" rel="noopener" target="_blank">GitHub</a>
      </div>
    </div>
  </section>

  <section class="section section--white">
    <div class="container split" style="--gap: 40px 64px">
      <div class="stack" style="--gap: 12px; flex: 1 1 280px">
        <p class="eyebrow">Parcours</p>
        <h2 class="h2" style="font-size: clamp(28px, 3vw, 40px)">De Conakry à une douzaine de pays.</h2>
      </div>
      <ol class="timeline">
        {
          parcours.map((p) => (
            <li>
              <span class="timeline__when">{p.when}</span>
              <div class="timeline__what">
                <strong>{p.role}</strong>
                <span>{p.where}</span>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section container grid-cards">
    <div class="card">
      <h2 class="h3">Formation</h2>
      <ul class="plain">
        {
          formation.map((f) => (
            <li class="stack" style="--gap: 0">
              <strong>{f.title}</strong>
              <span class="muted">{f.where}</span>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="card">
      <h2 class="h3">Certifications</h2>
      <ul class="plain" style="gap: 10px">{certifications.map((c) => <li>{c}</li>)}</ul>
    </div>
    <div class="card">
      <h2 class="h3">Langues</h2>
      <p style="font-size: 15px">Français (langue maternelle) · Anglais (courant)</p>
    </div>
  </section>

  <section class="container stack" style="--gap: 24px; padding-bottom: 96px">
    <h2 class="h2" style="font-size: clamp(26px, 3vw, 36px)">Boîte à outils</h2>
    <ul class="chips">{outils.map((o) => <li class="chip">{o}</li>)}</ul>
  </section>
</Base>

<style>
  .hero-founder {
    display: flex;
    flex-wrap: wrap;
    gap: 48px;
    align-items: stretch;
    padding-block: 56px 72px;
  }
  .hero-founder__photo {
    flex: 1 1 380px;
    min-width: 0;
    min-height: 620px;
    border-radius: var(--radius-lg);
    position: relative;
  }
  .hero-founder__photo :global(img) {
    position: absolute;
    inset: 0;
  }
  .hero-founder__text {
    flex: 999 1 480px;
    min-width: 0;
    justify-content: center;
  }
  .founder-role {
    font-size: 20px;
    font-weight: 500;
    color: var(--ink-2);
  }
  .timeline {
    flex: 2.4 1 520px;
    min-width: 0;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .timeline li {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 28px;
    padding-block: 18px;
    border-top: 1px solid var(--line);
  }
  .timeline li:last-child {
    border-bottom: 1px solid var(--line);
  }
  .timeline__when {
    flex: 0 0 150px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--ink-3);
    padding-top: 3px;
  }
  .timeline__what {
    flex: 1 1 300px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .timeline__what strong {
    font-size: 17px;
  }
  .timeline__what span {
    font-size: 15px;
    color: var(--ink-2);
  }
  .plain {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
    font-size: 15px;
    line-height: 1.5;
  }
  @media (max-width: 640px) {
    .hero-founder {
      padding-block: 32px 56px;
      gap: 32px;
    }
    .hero-founder__photo {
      min-height: 520px;
    }
  }
</style>
