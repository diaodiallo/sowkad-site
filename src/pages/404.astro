---
import Base from '../layouts/Base.astro';
---

<Base title="Page introuvable" description="Cette page n'existe pas ou a été déplacée.">
  <section class="container page-head stack" style="--gap: 22px; padding-bottom: 120px">
    <p class="eyebrow">Erreur 404</p>
    <h1 class="display">Cette page est introuvable.</h1>
    <p class="lead">Elle a peut-être été déplacée. Revenez à l'accueil ou écrivez-nous si vous cherchez une information précise.</p>
    <div class="btn-row">
      <a href="/" class="btn btn--primary">Retour à l'accueil</a>
      <a href="/contact/" class="btn btn--outline">Nous contacter</a>
    </div>
  </section>
</Base>
