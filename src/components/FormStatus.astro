---
// Affiche le résultat d'un envoi de formulaire (paramètre ?envoi=ok|erreur ajouté par envoi.php).
---

<p class="form-status form-status--ok" data-status="ok" role="status" hidden>
  Merci, votre message a bien été envoyé. Nous vous répondrons rapidement.
</p>
<p class="form-status form-status--error" data-status="erreur" role="alert" hidden>
  L'envoi n'a pas abouti. Vérifiez les champs obligatoires ou écrivez-nous directement par e-mail.
</p>

<script>
  const etat = new URLSearchParams(window.location.search).get('envoi');
  if (etat) {
    const el = document.querySelector<HTMLElement>(`[data-status="${etat === 'ok' ? 'ok' : 'erreur'}"]`);
    if (el) {
      el.hidden = false;
      el.scrollIntoView({ block: 'center' });
    }
  }
</script>
