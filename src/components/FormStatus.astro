---
// Affiche le résultat d'un envoi de formulaire (paramètre ?envoi=ok|erreur ajouté par envoi.php).
import { ui, type Lang } from '../i18n';
interface Props {
  lang: Lang;
}
const t = ui[Astro.props.lang].form;
---

<p class="form-status form-status--ok" data-status="ok" role="status" hidden>{t.ok}</p>
<p class="form-status form-status--error" data-status="erreur" role="alert" hidden>{t.error}</p>

<script>
  const etat = new URLSearchParams(window.location.search).get('envoi');
  if (etat) {
    const el = document.querySelector<HTMLElement>(`[data-status="${etat === 'ok' ? 'ok' : 'erreur'}"]`);
    if (el) {
      el.hidden = false;
      el.scrollIntoView({ block: 'center' });
    }
  }
</script>
