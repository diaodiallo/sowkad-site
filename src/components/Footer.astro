---
import { routes, ui, type Lang, type PageKey } from '../i18n';

interface Props {
  lang: Lang;
  page: PageKey;
}
const { lang, page } = Astro.props;
const t = ui[lang];
const other: Lang = lang === 'fr' ? 'en' : 'fr';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <span>© {year} Sowkad · {t.city} · <a href={routes.legal[lang]}>{t.legal}</a></span>
    <span>
      <span aria-current="true">{t.current}</span> ·
      <a href={routes[page][other]} hreflang={other} lang={other} title={t.switchLabel}>{t.switchTo}</a>
    </span>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
  }
  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    padding-block: 28px;
    font-size: 14px;
    color: var(--ink-3);
  }
</style>
