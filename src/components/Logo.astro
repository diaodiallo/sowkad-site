---
interface Props {
  size?: number;
}
const { size = 30 } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 30 30" aria-hidden="true">
  <rect x="1" y="1" width="28" height="28" rx="7" fill="var(--accent)"></rect>
  <path
    d="M8 15h4l2-5 3 10 2-5h3"
    fill="none"
    stroke="#FFFFFF"
    stroke-width="2.2"
    stroke-linecap="round"
    stroke-linejoin="round"></path>
</svg>
