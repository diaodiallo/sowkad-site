---
import '@fontsource-variable/manrope/wght.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { routes, ui, type Lang, type PageKey } from '../i18n';

interface Props {
  lang: Lang;
  page: PageKey;
  title: string;
  description: string;
}

const { lang, page, title, description } = Astro.props;
const t = ui[lang];
const tagline = lang === 'fr' ? 'Conseil en santé numérique' : 'Digital health consulting';
const fullTitle = page === 'home' ? `Sowkad — ${tagline}` : `${title} — Sowkad`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const alternates = page === 'notFound' ? [] : (['fr', 'en'] as Lang[]).map((l) => ({ lang: l, href: new URL(routes[page][l], Astro.site) }));
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {page !== 'notFound' && <link rel="canonical" href={canonical} />}
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    {alternates.length > 0 && <link rel="alternate" hreflang="x-default" href={alternates[0].href} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0f2a24" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_US'} />
    <meta property="og:site_name" content="Sowkad" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
  </head>
  <body>
    <a class="skip-link" href="#contenu">{t.skip}</a>
    <Header lang={lang} page={page} />
    <main id="contenu">
      <slot />
    </main>
    <Footer lang={lang} page={page} />
  </body>
</html>
